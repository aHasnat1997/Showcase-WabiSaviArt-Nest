# SERVER PORT
PORT=8080

# DATABASE URL
DATABASE_URL="postgresql://user:password@localhost:5432/acmemarketplace?schema=public"

# CORS ORIGINS (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://acmemarketplace.example.com"

# GOOGLE CREDENTIALS
GOOGLE_CLIENT_ID="<YOUR_GOOGLE_CLIENT_ID>"
GOOGLE_CLIENT_SECRET="<YOUR_GOOGLE_CLIENT_SECRET>"

# MEDIA CREDENTIALS
DEFAULT_AVATAR_URL="placeholders/profile-placeholder.png"
DEFAULT_IMAGE_URL="placeholders/image-placeholder.png"
BUCKET_NAME="acme-marketplace-media"
ENDPOINT="<YOUR_STORAGE_ENDPOINT>"
ACCESS_KEY_ID="<YOUR_ACCESS_KEY_ID>"
SECRET_ACCESS_KEY="<YOUR_SECRET_ACCESS_KEY>"

# OTHER CONFIGURATIONS
BCRYPT_SALT_OR_ROUNDS=10
JWT_SECRET="<YOUR_JWT_SECRET>"
ACCESS_TOKEN_COOKIE_NAME="acme-access-token"

# REDIS
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="<YOUR_REDIS_PASSWORD>"

# EMAIL CONFIGURATION - MAILTRAP / GMAIL
SMTP_HOST="<YOUR_SMTP_HOST>"
SMTP_PORT=587
SMTP_USER="<YOUR_SMTP_USER>"
SMTP_PASS="<YOUR_SMTP_PASS>"
SMTP_FROM="Acme Marketplace <support@acmemarketplace.example.com>"
APP_URL="http://localhost:8080"

# TWILIO CONFIGURATION
TWILIO_ACCOUNT_SID="<YOUR_TWILIO_ACCOUNT_SID>"
TWILIO_AUTH_TOKEN="<YOUR_TWILIO_AUTH_TOKEN>"
TWILIO_PHONE_NUMBER="<YOUR_TWILIO_PHONE_NUMBER>"

# WEBHOOKS
VERIFY_EMAIL_URL_WEBHOOKS="http://localhost:8080"

# Seed Admin User
ADMIN_EMAIL="admin@acmemarketplace.example.com"
ADMIN_FULL_NAME="Admin User"
ADMIN_AVATAR_URL="placeholders/seed-admin.jpg"
ADMIN_PASSWORD="<YOUR_ADMIN_PASSWORD>"
ADMIN_SESSION_SECRET="<YOUR_ADMIN_SESSION_SECRET>"

# Stripe Configuration
STRIPE_SECRET_KEY="<YOUR_STRIPE_SECRET_KEY>"
STRIPE_PUBLISHABLE_KEY="<YOUR_STRIPE_PUBLISHABLE_KEY>"
STRIPE_WEBHOOK_SECRET="<YOUR_STRIPE_WEBHOOK_SECRET>"

# Shopify Integration
SHOPIFY_API_KEY="<YOUR_SHOPIFY_API_KEY>"
SHOPIFY_API_SECRET="<YOUR_SHOPIFY_API_SECRET>"

# Etsy Integration
ETSY_API_KEY="<YOUR_ETSY_API_KEY>"
ETSY_API_SECRET="<YOUR_ETSY_API_SECRET>"
